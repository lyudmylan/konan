// Grafana Alloy — ship the konan lab's telemetry to Grafana Cloud (#53).
// Everything variable comes from the environment of the shell that runs Alloy: the six write
// credentials from the Cloud portal and KONAN_REPO, the absolute path of this checkout.
// Validate: `alloy validate docs/rims/grafana-cloud.alloy`; run: `alloy run docs/rims/grafana-cloud.alloy`.
// The steps: grafana-cloud.md, "Operator setup".

prometheus.scrape "faultline" {
  targets    = [{ __address__ = "127.0.0.1:8000" }]
  metrics_path = "/metrics"
  scrape_interval = "15s"
  forward_to = [prometheus.remote_write.gcloud.receiver]
}

prometheus.remote_write "gcloud" {
  endpoint {
    url = sys.env("GCLOUD_PROM_URL")
    basic_auth {
      username = sys.env("GCLOUD_PROM_USER")
      password = sys.env("GCLOUD_PROM_KEY")
    }
  }
}

local.file_match "faultline_logs" {
  path_targets = [{ __path__ = sys.env("KONAN_REPO") + "/lab/logs/app.log*", job = "faultline" }]   // job: the stream label
}

loki.source.file "faultline" {
  targets    = local.file_match.faultline_logs.targets
  forward_to = [loki.process.faultline.receiver]
}

loki.process "faultline" {
  stage.json { expressions = { level = "level", event = "event", request_id = "request_id" } }
  stage.labels { values = { level = "", event = "" } }   // request_id stays a field, not a label (cardinality)
  forward_to = [loki.write.gcloud.receiver]
}

loki.write "gcloud" {
  endpoint {
    url = sys.env("GCLOUD_LOKI_URL")
    basic_auth {
      username = sys.env("GCLOUD_LOKI_USER")
      password = sys.env("GCLOUD_LOKI_KEY")
    }
  }
}
