// Grafana Alloy — ship the konan lab's telemetry to Grafana Cloud (#53).
// Fill the four credentials from the Cloud portal; KONAN_REPO = this repo's absolute path.

prometheus.scrape "faultline" {
  targets    = [{ __address__ = "127.0.0.1:8000" }]
  metrics_path = "/metrics"
  scrape_interval = "15s"
  forward_to = [prometheus.remote_write.gcloud.receiver]
}

prometheus.remote_write "gcloud" {
  endpoint {
    url = env("GCLOUD_PROM_URL")
    basic_auth { username = env("GCLOUD_PROM_USER"), password = env("GCLOUD_PROM_KEY") }
  }
}

local.file_match "faultline_logs" {
  path_targets = [{ __path__ = env("KONAN_REPO") + "/lab/logs/app.log*" }]
}

loki.source.file "faultline" {
  targets    = local.file_match.faultline_logs.targets
  forward_to = [loki.process.faultline.receiver]
}

loki.process "faultline" {
  stage.json { expressions = { level = "level", event = "event", request_id = "request_id" } }
  stage.labels { values = { level = "", event = "" } }   // request_id stays a field, not a label (cardinality)
  forward_to = [loki.write.gcloud.receiver]
}

loki.write "gcloud" {
  endpoint {
    url = env("GCLOUD_LOKI_URL")
    basic_auth { username = env("GCLOUD_LOKI_USER"), password = env("GCLOUD_LOKI_KEY") }
  }
}
