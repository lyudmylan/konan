{
  "permissions": {
    "allow": [
      "Bash(scripts/probe.sh:*)",
      "Bash(./scripts/probe.sh:*)",
      "Bash(git add journals/:*)",
      "Bash(git commit -m:*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(http:*)",
      "Bash(xh:*)",
      "Bash(nc:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/boundary.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
